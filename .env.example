# Variables públicas del navegador (anon key es publicable; RLS protege los datos).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Únicamente para desarrollo visual local con perfiles ficticios.
VITE_USE_DEMO_DATA=false

# Solo scripts locales/CI. Nunca usar VITE_ ni exponerla en el navegador o Vercel.
# Úsala únicamente para importar datos privados o crear backups desde una terminal controlada.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE
BACKUP_ENCRYPTION_PASSWORD=UNA_FRASE_LARGA_Y_UNICA
